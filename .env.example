# Frontend environment variables (copy to .env.production / set in Vercel)

# Supabase: contact form, admin panel and Verification Portal (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe Payment Links (buy.stripe.com/...). Leave empty to route the CTA to the contact form.
VITE_STRIPE_LINK_LICENCE=
VITE_STRIPE_LINK_SPRINT=
VITE_STRIPE_LINK_INTEGRATION=
VITE_STRIPE_LINK_CLOUD=

# Google Analytics (optional)
VITE_ENABLE_ANALYTICS=false
VITE_GA_MEASUREMENT_ID=
